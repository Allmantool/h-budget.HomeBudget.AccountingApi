{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:home-ledger:portability:v1:settings",
  "title": "Home Ledger business settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultCurrencyId", "timeZone", "firstDayOfWeek", "fiscalYearStartMonth", "updatedUtc"],
  "properties": {
    "defaultCurrencyId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "timeZone": { "type": "string", "minLength": 1, "maxLength": 128 },
    "firstDayOfWeek": { "enum": ["monday", "sunday"] },
    "fiscalYearStartMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
    "updatedUtc": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
