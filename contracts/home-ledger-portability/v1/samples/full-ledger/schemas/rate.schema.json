{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:home-ledger:portability:v1:rate",
  "title": "Home Ledger historical rate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "baseCurrencyId", "quoteCurrencyId", "rate", "validOn", "source", "capturedUtc"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "baseCurrencyId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "quoteCurrencyId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "rate": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
    "validOn": { "type": "string", "format": "date" },
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "capturedUtc": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
