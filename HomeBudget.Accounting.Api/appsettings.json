{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "AWSSDK": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "WithThreadId", "WithMachineName" ]
  },
  "HealthCheckOptions": {
    "Host": ""
  },
  "DatabaseConnectionOptions": {
    "ConnectionString": "",
    "RedisConnectionString": ""
  },
  "ObservabilityOptions": {
    "TelemetryEndpoint": "",
    "LogsEndpoint": ""
  },
  "EventStoreDb": {
    "Url": "",
    "TimeoutInSeconds": 90,
    "RetryAttempts": 5
  },
  "ElasticSearchOptions": {
    "IsEnabled": true,
    "Uri": ""
  },
  "ElasticApm": {
    "ServerUrls": "",
    "ServiceName": "HomeBudget.Accounting.Api",
    "TransactionSampleRate": 1.0
  },
  "SeqOptions": {
    "IsEnabled": true,
    "Uri": ""
  },
  "MongoDbOptions": {
    "ConnectionString": "",
    "PaymentAccounts": "payment_accounts",
    "PaymentsHistory": "payments_history",
    "HandBooks": "handbooks",
    "LedgerDatabase": "ledger"
  },
  "Sentry": {
    "Dsn": ""
  },
  "KafkaOptions": {
    "ProducerSettings": {
      "BootstrapServers": ""
    },
    "ConsumerSettings": {
      "BootstrapServers": ""
    },
    "AdminSettings": {
      "BootstrapServers": ""
    },
    "Topics": {
      "RequestLoggerTopic": "topic-name"
    }
  },
  "PaymentOutboxPublisherOptions": {
    "IsEnabled": true,
    "BatchSize": 25,
    "PollIntervalMilliseconds": 1000,
    "LockTimeoutSeconds": 60,
    "MaxRetryAttempts": 5
  },
  "PaymentInboxOptions": {
    "MaxRetryAttempts": 5
  },
  "DataProtectionApi": {
    "Enabled": false,
    "RecentAuthenticationMinutes": 15,
    "ConfirmationLifetimeMinutes": 5,
    "ClockSkewSeconds": 60,
    "RequireHttpsMetadata": true
  },
  "DataProtectionRecovery": {
    "Enabled": false,
    "BackupCadenceMinutes": 30,
    "MaximumRpoMinutes": 60,
    "TargetRtoMinutes": 240,
    "PitrWindowDays": 30,
    "AllRecoveryPointsHours": 48,
    "DailyRecoveryPointsDays": 30,
    "MonthlyRecoveryPointsMonths": 12,
    "RestoreDrillIntervalDays": 30,
    "ProtectedCutoffWarningMinutes": 45,
    "ProtectedCutoffCriticalMinutes": 60,
    "RecordChangeThreshold": 1000,
    "ByteChangeThreshold": 104857600,
    "MaximumCoalescingMinutes": 15,
    "BackupProvider": "",
    "IndependentStore": "",
    "KeyReference": "",
    "NotificationTarget": "",
    "RecoveryHostResourceId": ""
  },
  "UiOriginsUrl": [ "*" ]
}
